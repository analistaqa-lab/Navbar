{
  "name": "mh-183-navbar-bdd-playwright-storybook",
  "version": "1.0.0",
  "private": true,
  "description": "Automação BDD com Playwright + Cucumber + POM + Allure para validar Navbar/Breadcrumb no Storybook",
  "scripts": {
    "test": "npm run test:bdd",
    "test:bdd": "cucumber-js",
    "test:smoke": "cucumber-js --tags '@smoke'",
    "test:mobile": "cucumber-js --tags '@mobile'",
    "allure:generate": "allure generate ./allure-results --clean -o ./allure-report",
    "allure:open": "allure open ./allure-report",
    "report:html": "allure generate ./allure-results --clean -o ./allure-report",
    "clean": "rimraf allure-results allure-report test-results .tmp",
    "pretest:bdd": "node ./scripts/ensure-env.js"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.2.0",
    "@playwright/test": "^1.54.0",
    "allure-commandline": "^2.34.1",
    "allure-js-commons": "^3.4.2",
    "allure-cucumberjs": "^3.4.2",
    "dotenv": "^16.6.1",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "wait-on": "^8.0.3",
    "storybook": "^9.1.0"
  }
}